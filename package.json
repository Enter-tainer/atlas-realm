{
  "name": "@atlas-realm/map",
  "version": "0.1.0",
  "description": "Reusable MapLibre GL style composer, OpenRailwayMap layers, Mapterhorn terrain/contours, and ORM popups from Atlas Realm.",
  "files": [
    "src"
  ],
